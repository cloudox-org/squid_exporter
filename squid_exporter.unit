# -*- mode: conf -*-

[Unit]
Description=Prometheus Squid proxy metric exporter
Documentation=https://github.com/boynux/squid-exporter
After=network.target

[Service]
EnvironmentFile=-/etc/default/squid_exporter
User=prometheus
ExecStart=/usr/bin/squid_exporter $SQUID_EXPORTER_OPTS
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s


[Install]
WantedBy=multi-user.target
